+//! X11 input capture.
+//!
+//! A dedicated thread owns its own Xlib connection. While no capture is active it
+//! polls the pointer position; when the pointer hits a screen edge that has a
+//! client configured, it grabs pointer and keyboard on the root window, hides the
+//! cursor and forwards relative motion, buttons, scroll and keys until `release`.
+//!
+//! Relative motion is measured against the screen center: every motion event is
+//! turned into a delta from the center and the pointer is warped back (the same
+//! technique Synergy/Deskflow use on X11), so pointer acceleration configured on
+//! this machine is preserved.
+
+use std::{
+    collections::HashSet,
+    os::raw::{c_char, c_uint},
+    ptr,
+    sync::mpsc as std_mpsc,
+    task::Poll,
+    thread,
+    time::Duration,
+};
 
 use async_trait::async_trait;
 use futures_core::Stream;
+use input_event::{
+    BTN_BACK, BTN_FORWARD, BTN_LEFT, BTN_MIDDLE, BTN_RIGHT, Event, KeyboardEvent, PointerEvent,
+};
+use tokio::sync::mpsc;
+use x11::xlib;
 
 use super::{Capture, CaptureError, CaptureEvent, Position, error::X11InputCaptureCreationError};
 
-pub struct X11InputCapture {}
+/// poll interval while waiting for the pointer to hit an edge
+const IDLE_POLL: Duration = Duration::from_millis(8);
+/// poll interval while capturing and no events are pending
+const ACTIVE_POLL: Duration = Duration::from_millis(1);
+
+enum Command {
+    Create(Position),
+    Destroy(Position),
+    Release,
+    Terminate,
+}
+
+type Item = Result<(Position, CaptureEvent), CaptureError>;
+
+pub struct X11InputCapture {
+    commands: std_mpsc::Sender<Command>,
+    events: mpsc::UnboundedReceiver<Item>,
+    thread: Option<thread::JoinHandle<()>>,
+}
 
 impl X11InputCapture {
     pub fn new() -> std::result::Result<Self, X11InputCaptureCreationError> {
-        Err(X11InputCaptureCreationError::NotImplemented)
+        let (cmd_tx, cmd_rx) = std_mpsc::channel();
+        let (ev_tx, ev_rx) = mpsc::unbounded_channel();
+        let (ready_tx, ready_rx) = std_mpsc::channel();
+        let thread = thread::Builder::new()
+            .name("x11-input-capture".into())
+            .spawn(move || match CaptureThread::open() {
+                Ok(mut t) => {
+                    let _ = ready_tx.send(Ok(()));
+                    t.run(cmd_rx, ev_tx);
+                }
+                Err(e) => {
+                    let _ = ready_tx.send(Err(e));
+                }
+            })
+            .map_err(|_| X11InputCaptureCreationError::Thread)?;
+        ready_rx
+            .recv()
+            .map_err(|_| X11InputCaptureCreationError::Thread)??;
+        Ok(Self {
+            commands: cmd_tx,
+            events: ev_rx,
+            thread: Some(thread),
+        })
+    }
+
+    fn send(&self, cmd: Command) -> Result<(), CaptureError> {
+        // the thread only goes away after `terminate`
+        let _ = self.commands.send(cmd);
+        Ok(())
+    }
+}
+
+impl Drop for X11InputCapture {
+    fn drop(&mut self) {
+        let _ = self.commands.send(Command::Terminate);
+        if let Some(t) = self.thread.take() {
+            let _ = t.join();
+        }
     }
 }
 
