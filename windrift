def save_config(cfg: dict, path: Path = CONFIG_PATH) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(render_config(cfg))
    path.chmod(0o600)   # внутри токен


def cmd_init(path: Path, force: bool) -> None:
    if path.exists() and not force:
        raise WindriftError(f"{path} уже есть (перезаписать: windrift init --force)")
    cfg = copy.deepcopy(DEFAULTS)
    cfg["name"] = socket.gethostname().split(".")[0]
    cfg["token"] = secrets.token_hex(32)
    save_config(cfg, path)
    print(f"создан {path}\nзаполни секцию [peer] (или открой `windrift settings`)")


# ───────────────────────── реестр сессий ─────────────────────────

def registry_path() -> Path:
    RUNTIME.mkdir(parents=True, exist_ok=True)
    return RUNTIME / "sessions.json"


def registry_load() -> dict:
    p = registry_path()
    return json.loads(p.read_text()) if p.exists() else {}


def registry_save(reg: dict) -> None:
    registry_path().write_text(json.dumps(reg, indent=2, ensure_ascii=False))


def free_display(cfg: dict, reg: dict) -> int:
    n = int(cfg["xpra"]["display_base"])
    while str(n) in reg or Path(f"/tmp/.X11-unix/X{n}").exists():
        n += 1
    return n


# ───────────────────────── xpra ─────────────────────────

def media_opts(cfg: dict) -> list[str]:
    x = cfg["xpra"]
    return [f"--speaker={'yes' if x['speaker'] else 'no'}",
            f"--microphone={'yes' if x['microphone'] else 'no'}"]


def attach_cmd(cfg: dict, owner: str, display: int) -> list[str]:
    """Клиент всегда подключается к ВЛАДЕЛЬЦУ — поэтому цепочек не бывает."""
    if owner == cfg["name"]:
        spec = f":{display}"                                   # локально, без сети
    elif owner == cfg["peer"]["name"]:
        spec = f"ssh://{cfg['peer']['ssh']}/{display}"         # напрямую к владельцу
    else:
        raise WindriftError(f"неизвестный владелец '{owner}'")
    x = cfg["xpra"]
    opts = ["--tray=no", "--splash=no", "--reconnect=no", *media_opts(cfg)]
    if x["encoding"] != "auto":
        opts.append(f"--encoding={x['encoding']}")
    if int(x["quality"]) > 0:
        opts.append(f"--quality={int(x['quality'])}")
    return ["xpra", "attach", spec, *opts, *x["attach_args"]]


def cmd_run(cfg: dict, argv: list[str]) -> None:
    if not argv:
        raise WindriftError("укажи программу: windrift run firefox")
    reg = registry_load()
    n = free_display(cfg, reg)
    env = os.environ.copy()
    env.pop("WAYLAND_DISPLAY", None)
    env.update(X11_ENV)
    server = [
        "xpra", "start", f":{n}",
        f"--start-child={shlex.join(argv)}",
        "--exit-with-children=yes",
        "--sharing=no",          # новый клиент вытесняет старого = «перенос»
        "--attach=no",
        "--daemon=yes",
        "--tray=no",
        *media_opts(cfg),
        *[f"--env={k}={v}" for k, v in X11_ENV.items()],
        *cfg["xpra"]["server_args"],
    ]
    log(f"старт сессии :{n} → {shlex.join(argv)}")
    subprocess.run(server, env=env, check=True)
    reg[str(n)] = {"cmd": argv, "started": time.time()}
    registry_save(reg)
    spawn_detached(attach_cmd(cfg, cfg["name"], n))


def cmd_list(cfg: dict) -> None:
    reg = registry_load()
    alive = {}
    for n, info in reg.items():
        if Path(f"/tmp/.X11-unix/X{n}").exists():
            alive[n] = info
            print(f":{n}\t{shlex.join(info['cmd'])}")
    if alive != reg:
        registry_save(alive)   # чистим мёртвые сессии
    if not alive:
        print("нет активных сессий")


def alive_sessions() -> list[int]:
    reg = registry_load()
    return sorted(int(n) for n in reg if Path(f"/tmp/.X11-unix/X{n}").exists())


def cmd_back(cfg: dict, display: int | None) -> None:
    """Вернуть свои окна на эту машину (локальный клиент вытеснит клиента у соседа)."""
    targets = [display] if display is not None else alive_sessions()
    if not targets:
        print("нет активных сессий на этой машине")
        return
    for n in targets:
        log(f"возвращаю сессию :{n} на эту машину")
        spawn_detached(attach_cmd(cfg, cfg["name"], n))


def place_window(pid: int, geom: dict | None, keep_proportions: bool = True,
                 decorations: bool = True, timeout: float = 15) -> None:
    """X11: поставить пришедшее окно так же, как оно стояло у соседа (в долях экрана),
    и при желании вернуть ему рамку. Без geom — только ужать, если не влезает."""
    if not shutil.which("xdotool"):
        return
    try:
        sw, sh = map(int, run_out(["xdotool", "getdisplaygeometry"]).split())
    except (WindriftError, ValueError, subprocess.TimeoutExpired):
        return
    deadline = time.time() + timeout
    while time.time() < deadline:
        wids = subprocess.run(["xdotool", "search", "--onlyvisible", "--pid", str(pid)],
                              capture_output=True, text=True).stdout.split()
        if wids:
            break
        time.sleep(0.3)
    else:
        return
    time.sleep(0.5)   # дать xpra выставить исходный размер
    for wid in wids:
        if decorations and shutil.which("xprop"):
            # _MOTIF_WM_HINTS: flags=DECORATIONS, decorations=1 → оконный менеджер рисует рамку
            subprocess.run(["xprop", "-id", wid, "-f", "_MOTIF_WM_HINTS", "32c",
                            "-set", "_MOTIF_WM_HINTS", "2, 0, 1, 0, 0"], capture_output=True)
        g = subprocess.run(["xdotool", "getwindowgeometry", "--shell", wid],
                           capture_output=True, text=True).stdout
        cur = dict(line.split("=", 1) for line in g.split() if "=" in line)
        w, h = int(cur.get("WIDTH", 0)), int(cur.get("HEIGHT", 0))
        if geom and keep_proportions:
            nw = max(200, min(sw, round(geom["w"] * sw)))
            nh = max(150, min(sh, round(geom["h"] * sh)))
            nx = min(max(0, round(geom["x"] * sw)), sw - nw)
            ny = min(max(0, round(geom["y"] * sh)), sh - nh)
        elif w > sw * 0.95 or h > sh * 0.9:
            nw, nh = min(w, int(sw * 0.85)), min(h, int(sh * 0.85))
            nx, ny = (sw - nw) // 2, (sh - nh) // 2
        else:
            continue
        subprocess.run(["xdotool", "windowsize", wid, str(nw), str(nh),
                        "windowmove", wid, str(nx), str(ny)], capture_output=True)
        log(f"окно {wid}: {w}x{h} → {nw}x{nh} в ({nx},{ny}) на экране {sw}x{sh}")


def cmd_stop(cfg: dict, display: int) -> None:
    subprocess.run(["xpra", "stop", f":{display}"], check=False)
    reg = registry_load()
    reg.pop(str(display), None)
    registry_save(reg)


# ───────────────────────── бэкенды композиторов ─────────────────────────

def session_kind() -> str:
    """wayland | x11 | none — куда показывать окна и откуда брать буфер обмена."""
    if os.environ.get("WAYLAND_DISPLAY"):
        return "wayland"
    if os.environ.get("DISPLAY"):
        return "x11"
    return "none"


def resolve_backend(backend: str) -> str:
    if backend != "auto":
        return backend
    env = os.environ
    desktop = env.get("XDG_CURRENT_DESKTOP", "").lower()
    if env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return "hyprland"
    if env.get("SWAYSOCK"):
        return "sway"
    if session_kind() == "wayland" and "kde" in desktop:
        return "kde"
    if session_kind() == "x11":
        return "x11"
    raise WindriftError("не удалось определить рабочий стол — укажи backend в конфиге")


def focused_pid(backend: str) -> int:
    backend = resolve_backend(backend)
    if backend == "x11":
        return int(run_out(["xdotool", "getactivewindow", "getwindowpid"]).strip())
    if backend == "hyprland":
        return int(json.loads(run_out(["hyprctl", "activewindow", "-j"]))["pid"])
    if backend == "kde":
        return int(run_out(["kdotool", "getactivewindow", "getwindowpid"]).strip())
    if backend == "sway":
        tree = json.loads(run_out(["swaymsg", "-t", "get_tree"]))
        stack = [tree]
        while stack:
            node = stack.pop()
            if node.get("focused") and node.get("pid"):
                return int(node["pid"])
            stack += node.get("nodes", []) + node.get("floating_nodes", [])
        raise WindriftError("sway: активное окно не найдено")
    raise WindriftError(f"неизвестный backend '{backend}' ({' | '.join(BACKENDS)})")


def parse_attach_args(cfg: dict, args: list[str]) -> tuple[str, int] | None:
    """Из командной строки xpra-клиента достаём (владелец, дисплей)."""
    if "attach" not in args:
        return None
    i = args.index("attach")
    if i + 1 >= len(args):
        return None
    spec = args[i + 1]
    if spec.startswith(":"):
        return cfg["name"], int(spec[1:])
    if spec.startswith("ssh://"):
        disp = spec.rsplit("/", 1)[1].lstrip(":")
        return cfg["peer"]["name"], int(disp)
    return None


def proc_args(pid: int) -> list[str]:
    raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    return [a.decode(errors="replace") for a in raw.split(b"\0") if a]


def proc_ppid(pid: int) -> int:
    stat = Path(f"/proc/{pid}/stat").read_text()
    return int(stat.rsplit(")", 1)[1].split()[1])


def window_session(cfg: dict, pid: int) -> tuple[str, int]:
    # окно принадлежит xpra-клиенту; на всякий случай поднимаемся по родителям
    for _ in range(4):
        if pid <= 1:
            break
        found = parse_attach_args(cfg, proc_args(pid))
        if found:
            return found
        pid = proc_ppid(pid)
    raise WindriftError("активное окно не из windrift — запускай программы через `windrift run`")


# ───────────────────────── сеть между демонами ─────────────────────────

def send_peer(cfg: dict, msg: dict, timeout: float = 5) -> dict:
    peer = cfg["peer"]
    payload = json.dumps({**msg, "token": cfg["token"]}, ensure_ascii=False) + "\n"
    with socket.create_connection((peer["host"], peer["port"]), timeout=timeout) as s:
        s.sendall(payload.encode())
        reply = s.makefile().readline()
    if not reply:
        raise WindriftError("сосед закрыл соединение")
    return json.loads(reply)


def window_geometry(backend: str) -> dict | None:
    """Место и размер активного окна в долях его монитора: {x, y, w, h} от 0 до 1."""
    try:
        backend = resolve_backend(backend)
        if backend == "hyprland":
            win = json.loads(run_out(["hyprctl", "activewindow", "-j"]))
            mons = json.loads(run_out(["hyprctl", "monitors", "-j"]))
            mon = next(m for m in mons if m["id"] == win["monitor"])
            scale = float(mon.get("scale") or 1)
            mw, mh = mon["width"] / scale, mon["height"] / scale
            if int(mon.get("transform", 0)) % 2:
                mw, mh = mh, mw
            (x, y), (w, h) = win["at"], win["size"]
            x, y = x - mon["x"], y - mon["y"]
        elif backend == "x11":
            g = run_out(["xdotool", "getactivewindow", "getwindowgeometry", "--shell"])
            geo = dict(line.split("=", 1) for line in g.split() if "=" in line)
            x, y, w, h = (int(geo[k]) for k in ("X", "Y", "WIDTH", "HEIGHT"))
            mw, mh = map(int, run_out(["xdotool", "getdisplaygeometry"]).split())
        else:
            return None
        clamp = lambda v: max(0.0, min(1.0, v))
        return {"x": clamp(x / mw), "y": clamp(y / mh), "w": clamp(w / mw), "h": clamp(h / mh)}
    except (WindriftError, OSError, ValueError, KeyError, StopIteration, subprocess.TimeoutExpired):
        return None


