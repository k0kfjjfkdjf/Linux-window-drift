# ───────────────────────── утилиты ─────────────────────────

class WindriftError(Exception):
    pass


def log(msg: str) -> None:
    print(f"[windrift {time.strftime('%H:%M:%S')}] {msg}", file=sys.stderr, flush=True)


def step(msg: str) -> None:
    print(f"\n\033[1;35m▶ {msg}\033[0m", flush=True)


def notify(msg: str) -> None:
    log(msg)
    if NOTIFY and shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "windrift", "windrift", msg], check=False)


def run_out(cmd: list[str], timeout: float = 5) -> str:
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    if r.returncode != 0:
        raise WindriftError(f"{shlex.join(cmd)} → {r.stderr.strip() or r.returncode}")
    return r.stdout


def spawn_detached(cmd: list[str], env: dict | None = None) -> int:
    RUNTIME.mkdir(parents=True, exist_ok=True)
    logf = open(RUNTIME / "xpra.log", "ab")
    p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=logf, stderr=logf,
                         start_new_session=True, env=env)
    return p.pid


# ───────────────────────── конфиг ─────────────────────────

def merge(base: dict, over: dict) -> dict:
    out = copy.deepcopy(base)
    for k, v in over.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = merge(out[k], v)
        else:
            out[k] = v
    return out


def load_config(path: Path = CONFIG_PATH, strict: bool = True) -> dict:
    over = {}
    if path.exists():
        with open(path, "rb") as f:
            over = tomllib.load(f)
    elif strict:
        raise WindriftError(f"нет конфига {path} — создай его: `windrift init` или `windrift settings`")
    cfg = merge(DEFAULTS, over)
    if strict:
        missing = [k for k in ("name", "token") if not cfg[k]]
        missing += [f"peer.{k}" for k in ("name", "host", "ssh") if not cfg["peer"][k]]
        if missing:
            raise WindriftError(f"в конфиге не заполнено: {', '.join(missing)}")
    global NOTIFY
    NOTIFY = bool(cfg["notify"])
    return cfg


def tv(v) -> str:
    """Значение Python → TOML."""
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, list):
        return "[" + ", ".join(tv(x) for x in v) + "]"
    raise TypeError(f"не умею записать {type(v)} в TOML")


