[ -d "$src/.git" ] || git clone -q --filter=blob:none "$UPSTREAM" "$src"
git -C "$src" fetch -q origin "$COMMIT" || git -C "$src" fetch -q origin
git -C "$src" checkout -q -f "$COMMIT"
git -C "$src" apply "$PATCH"
cd "$src"
echo "собираю lan-mouse (на ARM это займёт 10–30 минут)"
CARGO_HTTP_PROXY="$P" cargo build --release --no-default-features --features "$FEATURES"
install -Dm755 target/release/lan-mouse "$HOME/.local/bin/lan-mouse"
echo "lan-mouse установлен: $("$HOME/.local/bin/lan-mouse" --version 2>/dev/null | head -1)"
"""

# Сертификат lan-mouse (как у него самого: самоподписанный ECDSA P-256) и его отпечаток.
CERT_SH = r"""
set -e
d="${XDG_CONFIG_HOME:-$HOME/.config}/lan-mouse"; mkdir -p "$d"
if [ ! -s "$d/lan-mouse.pem" ]; then
  umask 077
  openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 36500 \
    -subj /CN=ignored -keyout "$d/key.tmp" -out "$d/cert.tmp" 2>/dev/null
  # lan-mouse (webrtc-dtls) ждёт заголовок PRIVATE_KEY с подчёркиванием
  openssl pkcs8 -topk8 -nocrypt -in "$d/key.tmp" | sed 's/PRIVATE KEY-----/PRIVATE_KEY-----/' > "$d/lan-mouse.pem"
  cat "$d/cert.tmp" >> "$d/lan-mouse.pem"
  rm -f "$d/key.tmp" "$d/cert.tmp"; chmod 400 "$d/lan-mouse.pem"
fi
sed -n '/BEGIN CERTIFICATE/,/END CERTIFICATE/p' "$d/lan-mouse.pem"
"""

PEER_LANMOUSE_RUN_SH = SESSION_ENV_SH + r"""
pkill -u "$(id -u)" -x lan-mouse || true
[ "$1" = stop ] && { echo "lan-mouse у соседа остановлен"; exit 0; }
log="${XDG_RUNTIME_DIR:-/tmp}/windrift/lan-mouse.log"; mkdir -p "$(dirname "$log")"
bin="$HOME/.local/bin/lan-mouse"
[ -x "$bin" ] || { echo "у соседа нет lan-mouse — запусти: windrift mouse setup" >&2; exit 1; }
if [ -n "$XDG_CURRENT_DESKTOP" ] && [ -d "$HOME/.config/autostart" -o "$kind" = x11 ]; then
  mkdir -p ~/.config/autostart
  printf '[Desktop Entry]\nType=Application\nName=lan-mouse\nExec=%s daemon\nNoDisplay=true\n' "$bin" \
    > ~/.config/autostart/lan-mouse.desktop
fi
RUST_LOG=info setsid -f "$bin" daemon >"$log" 2>&1 </dev/null
sleep 2
if pgrep -u "$(id -u)" -x lan-mouse >/dev/null; then echo "lan-mouse у соседа запущен"; else echo "lan-mouse у соседа не запустился:"; fi
tail -n 5 "$log"
"""


def pem_fingerprint(pem: str) -> str:
    """Отпечаток как у lan-mouse: sha256 первого сертификата (DER), hex через двоеточие."""
    import base64
    body = pem.split("-----BEGIN CERTIFICATE-----", 1)[1].split("-----END CERTIFICATE-----", 1)[0]
    der = base64.b64decode("".join(body.split()))
    return ":".join(f"{b:02x}" for b in hashlib.sha256(der).digest())


def lanmouse_config(capture: str, emulation: str, peer_name: str, peer_ip: str,
                    position: str, peer_fp: str) -> str:
    pos = {"up": "top", "down": "bottom"}.get(position, position)
    return f"""# создано windrift — windrift mouse setup перезапишет этот файл
capture_backend = {tv(capture)}
emulation_backend = {tv(emulation)}
port = {LANMOUSE_PORT}

[[clients]]
hostname = {tv(peer_name)}
ips = [{tv(peer_ip)}]
port = {LANMOUSE_PORT}
position = {tv(pos)}
activate_on_startup = true

[authorized_fingerprints]
{tv(peer_fp)} = {tv(peer_name)}
"""


def backends_for(kind: str) -> tuple[str, str]:
    """(capture, emulation) для lan-mouse по типу сессии."""
    return ("x11", "x11") if kind == "x11" else ("layer-shell", "wlroots")


def lanmouse_bin() -> str | None:
    local = Path.home() / ".local/bin/lan-mouse"
    return str(local) if local.exists() else shutil.which("lan-mouse")


def lanmouse_start_local(bin_path: str) -> None:
    subprocess.run(["pkill", "-u", str(os.getuid()), "-x", "lan-mouse"], capture_output=True)
    RUNTIME.mkdir(parents=True, exist_ok=True)
    log_path = RUNTIME / "lan-mouse.log"
    with open(log_path, "w") as logf:
        proc = subprocess.Popen([bin_path, "daemon"], stdin=subprocess.DEVNULL, stdout=logf, stderr=logf,
                                start_new_session=True, env={**os.environ, "RUST_LOG": "info"})
    time.sleep(2)
    print(log_path.read_text()[-600:] or "(лог пуст)")
    if proc.poll() is not None:
        raise WindriftError(f"lan-mouse здесь завершился (код {proc.returncode}), лог: {log_path}")


def cmd_mouse_setup(cfg: dict, config_path: Path) -> None:
    me, peer, target = cfg["name"], cfg["peer"]["name"], cfg["peer"]["ssh"]
    side = cfg["peer_side"]
    if side not in OPPOSITE:
        raise WindriftError(f"peer_side должен быть одним из {', '.join(OPPOSITE)}")
    bin_path = lanmouse_bin()
    if not bin_path:
        raise WindriftError("здесь нет lan-mouse: положи сборку в ~/.local/bin/lan-mouse "
                            "или поставь пакет (pacman -S lan-mouse)")
    # патч лежит в папке проекта (setup.dir), а не рядом с установленным ~/.local/bin/windrift
    candidates = [Path(os.path.expanduser(cfg["setup"]["dir"])), Path(os.path.realpath(__file__)).parent]
    repo = next((c for c in candidates if (c / "lan-mouse" / "x11-input-capture.patch").exists()), candidates[0])
    patch = repo / "lan-mouse" / "x11-input-capture.patch"
    commit_file = repo / "lan-mouse" / "UPSTREAM_COMMIT"
    s = cfg["setup"]
    peer_repo = s["dir"].replace("~", "$HOME", 1)
    commit = (commit_file.read_text().strip() if commit_file.exists()
              else subprocess.run(["git", "-C", str(repo), "show", "HEAD:lan-mouse/UPSTREAM_COMMIT"],
                                  capture_output=True, text=True).stdout.strip())
    if not commit or not patch.exists():
        raise WindriftError("нет lan-mouse/UPSTREAM_COMMIT или патча — обнови репозиторий windrift (git pull)")
    build_id = f"{commit}:{hashlib.sha256(patch.read_bytes()).hexdigest()[:12]}"

    step(f"1/5 windrift и патч lan-mouse на {peer}")
    remote_bash(target, f"""set -e
d="{peer_repo}"
if [ -d "$d/.git" ]; then git -C "$d" fetch -q origin && git -C "$d" reset -q --hard FETCH_HEAD
else git clone -q {shlex.quote(s["repo"])} "$d"; fi
install -Dm755 "$d/windrift" "$HOME/.local/bin/windrift"
test -f "$d/lan-mouse/x11-input-capture.patch" && echo "патч на месте"
""")

    step(f"2/5 сборка lan-mouse на {peer} (может спросить пароль sudo)")
    have = remote_bash(target, '[ -x "$HOME/.local/bin/lan-mouse" ] && "$HOME/.local/bin/lan-mouse" --version '
                               '2>/dev/null | head -1 || true', capture=True).stdout.strip()
    stamp = remote_bash(target, 'cat "$HOME/.cache/windrift/lan-mouse.commit" 2>/dev/null || true',
                        capture=True).stdout.strip()
    if have and stamp == build_id:
        print(f"уже собран: {have}")
    else:
        sport = 20000 + secrets.randbelow(30000)
        peer_kind = remote_bash(target, SESSION_ENV_SH + 'echo "$kind"', capture=True).stdout.strip() or "x11"
        features = "x11_capture,x11_emulation" if peer_kind != "wayland" else \
            "layer_shell_capture,wlroots_emulation,libei_capture,libei_emulation"
        env = (f"SOCKS={sport} COMMIT={commit} UPSTREAM={LANMOUSE_UPSTREAM} FEATURES={features} "
               f"PATCH={peer_repo}/lan-mouse/x11-input-capture.patch")
        remote_bash(target, "export " + env + "\n" + PEER_LANMOUSE_BUILD_SH +
                    f'\nmkdir -p "$HOME/.cache/windrift"; echo "{build_id}" > "$HOME/.cache/windrift/lan-mouse.commit"\n',
                    tty=True, socks_port=sport)

    step("3/5 сертификаты и отпечатки")
    my_pem = subprocess.run(["bash", "-c", CERT_SH], capture_output=True, text=True, check=True).stdout
    peer_pem = remote_bash(target, CERT_SH, capture=True).stdout
    my_fp, peer_fp = pem_fingerprint(my_pem), pem_fingerprint(peer_pem)
    print(f"{me}: {my_fp[:23]}…\n{peer}: {peer_fp[:23]}…")

    step("4/5 конфиги lan-mouse")
    my_ip = local_ip_towards(cfg["peer"]["host"])
    peer_ip = cfg["peer"]["host"]
    try:
        socket.inet_aton(peer_ip)
    except OSError:
        peer_ip = socket.gethostbyname(peer_ip)
    peer_kind = remote_bash(target, SESSION_ENV_SH + 'echo "$kind"', capture=True).stdout.strip() or "x11"
    LANMOUSE_CONF.mkdir(parents=True, exist_ok=True)
    conf = LANMOUSE_CONF / "config.toml"
    if conf.exists() and not conf.read_text().startswith("# создано windrift"):
        conf.rename(conf.with_suffix(".toml.bak"))
        print(f"старый конфиг сохранён: {conf.with_suffix('.toml.bak')}")
    conf.write_text(lanmouse_config(*backends_for(session_kind()), peer, peer_ip, side, peer_fp))
    remote_bash(target, """set -e
d="${XDG_CONFIG_HOME:-$HOME/.config}/lan-mouse"; mkdir -p "$d"; f="$d/config.toml"
if [ -f "$f" ] && ! head -1 "$f" | grep -q 'создано windrift'; then mv "$f" "$f.bak"; echo "старый конфиг соседа: $f.bak"; fi
cat > "$f"
""", input_text=lanmouse_config(*backends_for(peer_kind), me, my_ip, OPPOSITE[side], my_fp))
    print(f"{me} ({session_kind()}): сосед {peer} {side} ({peer_ip})\n"
          f"{peer} ({peer_kind}): сосед {me} {OPPOSITE[side]} ({my_ip})")

    step("5/5 запуск")
    cmd_mouse(cfg, config_path, "start")


def cmd_mouse_lanmouse(cfg: dict, action: str) -> None:
    target = cfg["peer"]["ssh"]
    # Deskflow больше не нужен — гасим, чтобы не делили мышь
    subprocess.run(["pkill", "-u", str(os.getuid()), "-f", "deskflow-(server|core server)"], capture_output=True)
    if action == "stop":
        subprocess.run(["pkill", "-u", str(os.getuid()), "-x", "lan-mouse"], capture_output=True)
        subprocess.run(["ssh", target, "env bash -s stop"], input=PEER_LANMOUSE_RUN_SH, text=True)
        print("lan-mouse здесь остановлен")
        return
    if not (LANMOUSE_CONF / "config.toml").exists():
        raise WindriftError("lan-mouse ещё не настроен: windrift mouse setup")
    step("lan-mouse здесь")
    lanmouse_start_local(lanmouse_bin())
    step("lan-mouse у соседа")
    subprocess.run(["ssh", target, "pkill -u \"$(id -u)\" -f 'deskflow-(client|core client)'; true"],
                   capture_output=True)
    subprocess.run(["ssh", target, "env bash -s start"], input=PEER_LANMOUSE_RUN_SH, text=True)
    print(f"\nМышь ходит в обе стороны: уведи курсор за край к соседу и обратно, "
          f"с любой из мышей. Логи: {RUNTIME}/lan-mouse.log здесь и у соседа."
          "\nОстановить: windrift mouse stop")

def cmd_mouse(cfg: dict, config_path: Path, action: str) -> None:
    if action == "setup":
        return cmd_mouse_setup(cfg, config_path)
    if lanmouse_bin() and (LANMOUSE_CONF / "config.toml").exists() and action != "deskflow":
        return cmd_mouse_lanmouse(cfg, action)
    action = "start" if action == "deskflow" else action
    me, peer = cfg["name"], cfg["peer"]["name"]
    side = cfg["peer_side"]
    if side not in OPPOSITE:
        raise WindriftError(f"peer_side должен быть одним из {', '.join(OPPOSITE)}")
    port = int(cfg["mouse_port"])
    local_re = r"deskflow-(server|core server)"
    subprocess.run(["pkill", "-u", str(os.getuid()), "-f", local_re], capture_output=True)
    remote_env = (f"NAME={shlex.quote(peer)} PORT={port} "
                  f"SERVER={shlex.quote(local_ip_towards(cfg['peer']['host']))}")
    if action == "stop":
        subprocess.run(["ssh", cfg["peer"]["ssh"], f"env {remote_env} bash -s stop"],
                       input=PEER_MOUSE_SH, text=True)
        print("сервер Deskflow остановлен")
        return
    if subprocess.run(["pgrep", "-x", "deskflow"], capture_output=True).returncode == 0:
        print("внимание: открыто окно Deskflow — закрой его, чтобы оно не мешало консольному серверу")

    d = config_path.parent / "deskflow"
    d.mkdir(parents=True, exist_ok=True)
    screens = d / "screens.conf"
    use_core = bool(shutil.which("deskflow-core"))
    # Deskflow 1.27+ (deskflow-core) берёт список компьютеров из [computer_<имя>] в настройках
    # и игнорирует секцию screens; старый deskflow-server читает её из этого файла.
    screens.write_text(
        ("" if use_core else f"section: screens\n\t{me}:\n\t{peer}:\nend\n\n") +
        "section: links\n"
        f"\t{me}:\n\t\t{side} = {peer}\n"
        f"\t{peer}:\n\t\t{OPPOSITE[side]} = {me}\n"
        "end\n")
    RUNTIME.mkdir(parents=True, exist_ok=True)
    log_path = RUNTIME / "deskflow-server.log"
    if use_core:
        ini = d / "server.ini"
        ini.write_text(f"[core]\ncoreMode=2\ncomputerName={me}\nport={port}\n"
                       f"[server]\nexternalConfig=true\nexternalConfigFile={screens}\nenableClipboard=true\n"
                       "[security]\ntlsEnabled=false\n"
                       f"[computer_{me}]\nname={me}\n"
                       f"[computer_{peer}]\nname={peer}\n")
        cmd = ["deskflow-core", "server", "--new-instance", "-s", str(ini)]
    elif shutil.which("deskflow-server"):
        cmd = ["deskflow-server", "-f", "-1", "-n", me, "-c", str(screens), "-a", f":{port}"]
    else:
        raise WindriftError("нет Deskflow: sudo pacman -S deskflow (или apt install deskflow)")
    with open(log_path, "w") as logf:
        server = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=logf, stderr=logf,
                                  start_new_session=True)
    step(f"сервер Deskflow на {me} (сосед {peer} — {side}), порт {port}")
    print("Hyprland может спросить разрешение на захват ввода — разреши.")
    time.sleep(3)
    print(log_path.read_text()[-800:] or "(лог пуст)")
    if server.poll() is not None:
        raise WindriftError(f"сервер Deskflow завершился (код {server.returncode}), лог: {log_path}")

    step(f"клиент Deskflow на {peer}")
    subprocess.run(["ssh", cfg["peer"]["ssh"], f"env {remote_env} bash -s start"],
                   input=PEER_MOUSE_SH, text=True)
    print(f"\nУведи курсор за {'правый' if side == 'right' else 'левый' if side == 'left' else 'верхний' if side == 'up' else 'нижний'}"
          f" край экрана. Логи: {log_path} и {RUNTIME}/deskflow-client.log у соседа."
          "\nОстановить: windrift mouse stop")


