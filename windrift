def save_config(cfg: dict, path: Path = CONFIG_PATH) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(render_config(cfg))
    path.chmod(0o600)   # внутри токен


def cmd_init(path: Path, force: bool) -> None:
    if path.exists() and not force:
        raise WindriftError(f"{path} уже есть (перезаписать: windrift init --force)")
    cfg = copy.deepcopy(DEFAULTS)
    cfg["name"] = socket.gethostname().split(".")[0]
    cfg["token"] = secrets.token_hex(32)
    save_config(cfg, path)
    print(f"создан {path}\nзаполни секцию [peer] (или открой `windrift settings`)")


# ───────────────────────── реестр сессий ─────────────────────────

def registry_path() -> Path:
    RUNTIME.mkdir(parents=True, exist_ok=True)
    return RUNTIME / "sessions.json"


def registry_load() -> dict:
    p = registry_path()
    return json.loads(p.read_text()) if p.exists() else {}


def registry_save(reg: dict) -> None:
    registry_path().write_text(json.dumps(reg, indent=2, ensure_ascii=False))


def free_display(cfg: dict, reg: dict) -> int:
    n = int(cfg["xpra"]["display_base"])
    while str(n) in reg or Path(f"/tmp/.X11-unix/X{n}").exists():
        n += 1
    return n


# ───────────────────────── xpra ─────────────────────────

def media_opts(cfg: dict) -> list[str]:
    x = cfg["xpra"]
    return [f"--speaker={'yes' if x['speaker'] else 'no'}",
            f"--microphone={'yes' if x['microphone'] else 'no'}"]


def attach_cmd(cfg: dict, owner: str, display: int) -> list[str]:
    """Клиент всегда подключается к ВЛАДЕЛЬЦУ — поэтому цепочек не бывает."""
    if owner == cfg["name"]:
        spec = f":{display}"                                   # локально, без сети
    elif owner == cfg["peer"]["name"]:
        spec = f"ssh://{cfg['peer']['ssh']}/{display}"         # напрямую к владельцу
    else:
        raise WindriftError(f"неизвестный владелец '{owner}'")
    x = cfg["xpra"]
    opts = ["--tray=no", "--splash=no", "--reconnect=no", *media_opts(cfg)]
    if x["encoding"] != "auto":
        opts.append(f"--encoding={x['encoding']}")
    if int(x["quality"]) > 0:
        opts.append(f"--quality={int(x['quality'])}")
    return ["xpra", "attach", spec, *opts, *x["attach_args"]]


def cmd_run(cfg: dict, argv: list[str]) -> None:
    if not argv:
        raise WindriftError("укажи программу: windrift run firefox")
    reg = registry_load()
    n = free_display(cfg, reg)
    env = os.environ.copy()
    env.pop("WAYLAND_DISPLAY", None)
    env.update(X11_ENV)
    server = [
        "xpra", "start", f":{n}",
        f"--start-child={shlex.join(argv)}",
        "--exit-with-children=yes",
        "--sharing=no",          # новый клиент вытесняет старого = «перенос»
        "--attach=no",
        "--daemon=yes",
        "--tray=no",
        *media_opts(cfg),
        *[f"--env={k}={v}" for k, v in X11_ENV.items()],
        *cfg["xpra"]["server_args"],
    ]
    log(f"старт сессии :{n} → {shlex.join(argv)}")
    subprocess.run(server, env=env, check=True)
    reg[str(n)] = {"cmd": argv, "started": time.time()}
    registry_save(reg)
    spawn_detached(attach_cmd(cfg, cfg["name"], n))


def cmd_list(cfg: dict) -> None:
    reg = registry_load()
    alive = {}
    for n, info in reg.items():
        if Path(f"/tmp/.X11-unix/X{n}").exists():
            alive[n] = info
            print(f":{n}\t{shlex.join(info['cmd'])}")
    if alive != reg:
        registry_save(alive)   # чистим мёртвые сессии
    if not alive:
        print("нет активных сессий")


def cmd_stop(cfg: dict, display: int) -> None:
    subprocess.run(["xpra", "stop", f":{display}"], check=False)
    reg = registry_load()
    reg.pop(str(display), None)
    registry_save(reg)


# ───────────────────────── бэкенды композиторов ─────────────────────────

def focused_pid(backend: str) -> int:
    if backend == "hyprland":
        return int(json.loads(run_out(["hyprctl", "activewindow", "-j"]))["pid"])
    if backend == "kde":
        return int(run_out(["kdotool", "getactivewindow", "getwindowpid"]).strip())
    if backend == "sway":
        tree = json.loads(run_out(["swaymsg", "-t", "get_tree"]))
        stack = [tree]
        while stack:
            node = stack.pop()
            if node.get("focused") and node.get("pid"):
                return int(node["pid"])
            stack += node.get("nodes", []) + node.get("floating_nodes", [])
        raise WindriftError("sway: активное окно не найдено")
    raise WindriftError(f"неизвестный backend '{backend}' ({' | '.join(BACKENDS)})")


def parse_attach_args(cfg: dict, args: list[str]) -> tuple[str, int] | None:
    """Из командной строки xpra-клиента достаём (владелец, дисплей)."""
    if "attach" not in args:
        return None
    i = args.index("attach")
    if i + 1 >= len(args):
        return None
    spec = args[i + 1]
    if spec.startswith(":"):
        return cfg["name"], int(spec[1:])
    if spec.startswith("ssh://"):
        disp = spec.rsplit("/", 1)[1].lstrip(":")
        return cfg["peer"]["name"], int(disp)
    return None


def proc_args(pid: int) -> list[str]:
    raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    return [a.decode(errors="replace") for a in raw.split(b"\0") if a]


def proc_ppid(pid: int) -> int:
    stat = Path(f"/proc/{pid}/stat").read_text()
    return int(stat.rsplit(")", 1)[1].split()[1])


def window_session(cfg: dict, pid: int) -> tuple[str, int]:
    # окно принадлежит xpra-клиенту; на всякий случай поднимаемся по родителям
    for _ in range(4):
        if pid <= 1:
            break
        found = parse_attach_args(cfg, proc_args(pid))
        if found:
            return found
        pid = proc_ppid(pid)
    raise WindriftError("активное окно не из windrift — запускай программы через `windrift run`")


# ───────────────────────── сеть между демонами ─────────────────────────

def send_peer(cfg: dict, msg: dict, timeout: float = 5) -> dict:
    peer = cfg["peer"]
    payload = json.dumps({**msg, "token": cfg["token"]}, ensure_ascii=False) + "\n"
    with socket.create_connection((peer["host"], peer["port"]), timeout=timeout) as s:
        s.sendall(payload.encode())
        reply = s.makefile().readline()
    if not reply:
        raise WindriftError("сосед закрыл соединение")
    return json.loads(reply)


def cmd_send(cfg: dict) -> None:
    pid = focused_pid(cfg["backend"])
    owner, display = window_session(cfg, pid)
    log(f"окно pid={pid}: сессия :{display}, владелец {owner} → отправляю на {cfg['peer']['name']}")
    reply = send_peer(cfg, {"cmd": "attach", "owner": owner, "display": display})
    if not reply.get("ok"):
        raise WindriftError(f"сосед отказал: {reply.get('error')}")
    # Локальный клиент отключится сам: xpra-сервер с sharing=no вытеснит его.


# ───────────────────────── буфер обмена ─────────────────────────

class Clipboard:
    """Синхронизация текста через wl-paste/wl-copy (опрос)."""

    def __init__(self, cfg: dict):
        self.cfg = cfg
        self.interval = float(cfg["clipboard_interval"])
        self.max_bytes = int(cfg["clipboard_max_kb"]) * 1024
        self.last = self._hash(self._read())

    @staticmethod
    def _hash(data: bytes | None) -> str | None:
        return hashlib.sha256(data).hexdigest() if data is not None else None

    @staticmethod
    def _read() -> bytes | None:
        try:
            r = subprocess.run(["wl-paste", "--no-newline", "--type", "text"],
                               capture_output=True, timeout=2)
        except subprocess.TimeoutExpired:
            return None
        return r.stdout if r.returncode == 0 else None

    def set_from_peer(self, text: str) -> None:
        data = text.encode()
        self.last = self._hash(data)   # не отправлять обратно → нет пинг-понга
        subprocess.run(["wl-copy"], input=data, timeout=2, check=False)

    async def loop(self) -> None:
        while True:
            data = await asyncio.to_thread(self._read)
            h = self._hash(data)
            if data is not None and h != self.last:
                self.last = h
                if len(data) <= self.max_bytes:
                    try:
                        await asyncio.to_thread(send_peer, self.cfg,
                                                {"cmd": "clip", "data": data.decode(errors="replace")})
                    except (OSError, WindriftError) as e:
                        log(f"буфер не отправлен: {e}")
            await asyncio.sleep(self.interval)


# ───────────────────────── демон ─────────────────────────

async def handle(reader, writer, cfg: dict, clip: Clipboard | None) -> None:
    peer_addr = writer.get_extra_info("peername")
    try:
        line = await asyncio.wait_for(reader.readline(), timeout=5)
        msg = json.loads(line)
        if not hmac.compare_digest(str(msg.get("token", "")), cfg["token"]):
            raise WindriftError("неверный token")
        cmd = msg.get("cmd")
        if cmd == "ping":
            reply = {"ok": True, "name": cfg["name"]}
        elif cmd == "attach":
            argv = attach_cmd(cfg, msg["owner"], int(msg["display"]))
            log(f"принимаю окно: {shlex.join(argv)}")
            spawn_detached(argv)
            reply = {"ok": True}
        elif cmd == "clip":
            if clip:
                clip.set_from_peer(msg["data"])
            reply = {"ok": True}
        else:
            raise WindriftError(f"неизвестная команда {cmd}")
    except Exception as e:  # noqa: BLE001 — демон не должен падать
        log(f"ошибка от {peer_addr}: {e}")
        reply = {"ok": False, "error": str(e)}
    writer.write((json.dumps(reply, ensure_ascii=False) + "\n").encode())
    await writer.drain()
    writer.close()


async def daemon(cfg: dict) -> None:
    if not os.environ.get("WAYLAND_DISPLAY"):
        log("внимание: WAYLAND_DISPLAY не задан — принятые окна некуда будет показать")
    clip = Clipboard(cfg) if cfg["clipboard"] and shutil.which("wl-paste") else None
    server = await asyncio.start_server(lambda r, w: handle(r, w, cfg, clip),
                                        cfg["listen"], cfg["port"])
    log(f"демон '{cfg['name']}' слушает {cfg['listen']}:{cfg['port']}, буфер обмена: {'да' if clip else 'нет'}")
    tasks = [server.serve_forever()]
    if clip:
        tasks.append(clip.loop())
    await asyncio.gather(*tasks)


# ───────────────────────── doctor ─────────────────────────

def cmd_doctor(cfg: dict) -> None:
    need = {"xpra": True, "ssh": True, "wl-paste": cfg["clipboard"], "wl-copy": cfg["clipboard"],
            {"hyprland": "hyprctl", "kde": "kdotool", "sway": "swaymsg"}.get(cfg["backend"], "?"): True}
    ok = True
    for tool, required in need.items():
        if required:
            found = shutil.which(tool)
            ok &= bool(found)
            print(f"{'✓' if found else '✗'} {tool}")
    try:
        r = send_peer(cfg, {"cmd": "ping"}, timeout=3)
        print(f"✓ демон соседа отвечает: {r.get('name')}" if r.get("ok") else f"✗ сосед: {r.get('error')}")
        ok &= bool(r.get("ok"))
    except OSError as e:
        print(f"✗ демон соседа недоступен: {e}")
        ok = False
    r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3",
                        cfg["peer"]["ssh"], "command -v xpra"], capture_output=True, text=True)
    print(f"{'✓' if r.returncode == 0 else '✗'} ssh {cfg['peer']['ssh']} без пароля и с xpra")
    ok &= r.returncode == 0
    sys.exit(0 if ok else 1)


# ───────────────────────── установка на соседа ─────────────────────────

def ssh_ok(target: str) -> bool:
    return subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", target, "true"],
                          capture_output=True).returncode == 0


def ssh_hostname(target: str) -> str:
    """Реальный адрес за ssh-алиасом (ssh -G pc1)."""
    out = run_out(["ssh", "-G", target])
    for line in out.splitlines():
        if line.startswith("hostname "):
            return line.split(None, 1)[1]
    return target.split("@")[-1]


def local_ip_towards(host: str) -> str:
    """Наш IP, с которого виден сосед."""
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.connect((host, 9))
        return s.getsockname()[0]


def remote_bash(target: str, script: str, tty: bool = False, input_text: str | None = None,
                capture: bool = False) -> subprocess.CompletedProcess:
    # оборачиваем в bash -c: у соседа login shell может быть fish
    cmd = ["ssh", *(["-t"] if tty else []), target, "bash -c " + shlex.quote(script)]
    return subprocess.run(cmd, input=input_text, text=True, check=True,
                          capture_output=capture)


def cmd_setup_peer(cfg: dict, target: str | None, peer_backend: str | None) -> None:
    target = target or cfg["peer"]["ssh"]
    if not target:
        raise WindriftError("не задан ssh соседа: windrift setup-peer user@host")
    if not cfg["peer"]["name"]:
        raise WindriftError("заполни peer.name в конфиге (имя соседа)")
    if not cfg["token"]:
        cfg["token"] = secrets.token_hex(32)
    cfg["peer"]["ssh"] = target
    if not cfg["peer"]["host"]:
        cfg["peer"]["host"] = ssh_hostname(target)
    save_config(cfg)

    step(f"1/5 ssh-ключ: эта машина → {target}")
    if ssh_ok(target):
        print("уже настроен")
    else:
        key = Path.home() / ".ssh" / "id_ed25519"
        if not key.exists():
            subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", str(key)], check=True)
        subprocess.run(["ssh-copy-id", target], check=True)

    step("2/5 пакеты и windrift на соседе (может спросить пароль sudo)")
    s = cfg["setup"]
    d = s["dir"].replace("~", "$HOME", 1)
    remote_bash(target, f"""set -e
sudo pacman -S --needed {" ".join(shlex.quote(p) for p in s["packages"])}
sudo systemctl enable --now sshd
if [ -d "{d}/.git" ]; then git -C "{d}" pull --ff-only; else git clone {shlex.quote(s["repo"])} "{d}"; fi
install -Dm755 "{d}/windrift" "$HOME/.local/bin/windrift"
install -Dm644 "{d}/windrift-settings.desktop" "$HOME/.local/share/applications/windrift-settings.desktop" || true
""", tty=True)

    step(f"3/5 ssh-ключ: {target} → эта машина")
    pub = remote_bash(target, """set -e
[ -f ~/.ssh/id_ed25519.pub ] || ssh-keygen -q -t ed25519 -N "" -f ~/.ssh/id_ed25519
cat ~/.ssh/id_ed25519.pub
""", capture=True).stdout.strip()
    ssh_dir = Path.home() / ".ssh"
    ssh_dir.mkdir(mode=0o700, exist_ok=True)
    auth = ssh_dir / "authorized_keys"
    existing = auth.read_text() if auth.exists() else ""
    if pub and pub not in existing:
        with open(auth, "a") as f:
            f.write(("" if existing.endswith("\n") or not existing else "\n") + pub + "\n")
        auth.chmod(0o600)
        print("ключ соседа добавлен в ~/.ssh/authorized_keys")
    else:
        print("ключ соседа уже есть")
    if subprocess.run(["systemctl", "is-active", "--quiet", "sshd"]).returncode != 0:
        print("здесь не запущен sshd — включаю (может спросить пароль sudo)")
        subprocess.run(["sudo", "systemctl", "enable", "--now", "sshd"], check=False)

    step("4/5 зеркальный конфиг на соседе")
    my_ip = local_ip_towards(cfg["peer"]["host"])
    pcfg = copy.deepcopy(cfg)
    pcfg["name"] = cfg["peer"]["name"]
    pcfg["backend"] = peer_backend or cfg["backend"]
    pcfg["peer"] = {"name": cfg["name"], "host": my_ip, "port": cfg["port"],
                    "ssh": f"{getpass.getuser()}@{my_ip}"}
    remote_bash(target, """set -e
mkdir -p ~/.config/windrift
f=~/.config/windrift/config.toml
[ -f "$f" ] && cp "$f" "$f.bak" && echo "старый конфиг сохранён в $f.bak"
cat > "$f"
chmod 600 "$f"
""", input_text=render_config(pcfg))
    print(f"name={pcfg['name']}, backend={pcfg['backend']}, peer={my_ip}")

    step("5/5 проверка")
    ok = ssh_ok(target)
    print(f"{'✓' if ok else '✗'} ssh {target}")
    r = remote_bash(target, f"ssh -o BatchMode=yes -o ConnectTimeout=5 {getpass.getuser()}@{my_ip} true "
                            "&& echo ok || echo fail", capture=True)
    back = r.stdout.strip().endswith("ok")
    print(f"{'✓' if back else '✗'} ssh обратно с соседа на {my_ip}")
    print("\nГотово. Осталось запустить демон на обеих машинах:\n"
          "  Hyprland: exec-once = windrift daemon   (в hyprland.conf)\n"
          "  KDE: Автозапуск → windrift daemon\n"
          "и проверить: windrift doctor")


# ───────────────────────── окно настроек ─────────────────────────

TERMINALS = [  # (бинарь, как передать команду)
    ("kitty", ["--"]), ("foot", []), ("alacritty", ["-e"]), ("wezterm", ["start", "--"]),
    ("konsole", ["-e"]), ("gnome-terminal", ["--"]), ("xterm", ["-e"]),
]


def open_in_terminal(cmd: list[str]) -> bool:
    hold = ["bash", "-c", shlex.join(cmd) + '; echo; read -rp "Enter — закрыть "']
    env_term = os.environ.get("TERMINAL")
    candidates = ([(env_term, ["-e"])] if env_term else []) + TERMINALS
    for term, prefix in candidates:
        if shutil.which(term):
            subprocess.Popen([term, *prefix, *hold], start_new_session=True)
            return True
    return False


def cmd_settings(path: Path) -> None:
    try:
        import gi
        gi.require_version("Gtk", "4.0")
        from gi.repository import GLib, Gtk
    except (ImportError, ValueError):
        raise WindriftError("для окна настроек нужны пакеты python-gobject и gtk4: "
                            "sudo pacman -S python-gobject gtk4")

    cfg = load_config(path, strict=False)
    if not cfg["name"]:
        cfg["name"] = socket.gethostname().split(".")[0]
    script = os.path.realpath(__file__)

    def get(keypath):
        node = cfg
        for k in keypath.split("."):
            node = node[k]
        return node

    def put(target, keypath, value):
        *head, last = keypath.split(".")
        for k in head:
            target = target[k]
        target[last] = value

    def on_activate(app):
        win = Gtk.ApplicationWindow(application=app, title="windrift — настройки")
        win.set_default_size(620, 760)
        readers: dict = {}

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        for side in ("top", "bottom", "start", "end"):
            getattr(outer, f"set_margin_{side}")(16)
        win.set_child(outer)

        scroll = Gtk.ScrolledWindow(vexpand=True)
        form = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        scroll.set_child(form)
        outer.append(scroll)

        grid = None
        row = 0
        labels = Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL)   # одна колонка подписей

        def section(title):
            nonlocal grid, row
            lbl = Gtk.Label(xalign=0)
            lbl.set_markup(f"<b>{GLib.markup_escape_text(title)}</b>")
            lbl.set_margin_top(12)
            form.append(lbl)
            grid = Gtk.Grid(column_spacing=12, row_spacing=6)
            form.append(grid)
            row = 0

        def add(label, widget, hint=""):
            nonlocal row
            lbl = Gtk.Label(label=label, xalign=0)
            labels.add_widget(lbl)
            widget.set_hexpand(True)
            if hint:
                lbl.set_tooltip_text(hint)
                widget.set_tooltip_text(hint)
            grid.attach(lbl, 0, row, 1, 1)
            grid.attach(widget, 1, row, 1, 1)
            row += 1

        def entry(key, label, hint=""):
            e = Gtk.Entry(text=str(get(key)))
            add(label, e, hint)
            readers[key] = lambda: e.get_text().strip()
            return e

        def list_entry(key, label, hint=""):
            e = Gtk.Entry(text=shlex.join(get(key)))
            add(label, e, hint + " (через пробел, как в shell)")
            readers[key] = lambda: shlex.split(e.get_text())

        def spin(key, label, lo, hi, step_, digits=0, hint=""):
            sp = Gtk.SpinButton.new_with_range(lo, hi, step_)
            sp.set_digits(digits)
            sp.set_value(float(get(key)))
            add(label, sp, hint)
            readers[key] = (lambda: round(sp.get_value(), digits)) if digits else (lambda: int(sp.get_value()))

        def switch(key, label, hint=""):
            sw = Gtk.Switch(active=bool(get(key)), halign=Gtk.Align.START)
            add(label, sw, hint)
            readers[key] = sw.get_active

        def dropdown(key, label, options, hint=""):
            dd = Gtk.DropDown.new_from_strings(options)
            cur = str(get(key))
            dd.set_selected(options.index(cur) if cur in options else 0)
            add(label, dd, hint)
            readers[key] = lambda: options[dd.get_selected()]

        section("Эта машина")
        entry("name", "Имя", "имя этой машины, без пробелов")
        tok = Gtk.Box(spacing=6)
        tok_entry = Gtk.Entry(text=cfg["token"], hexpand=True, visibility=False)
        tok_show = Gtk.ToggleButton(label="👁")
        tok_show.connect("toggled", lambda b: tok_entry.set_visibility(b.get_active()))
        tok_gen = Gtk.Button(label="Сгенерировать")
        tok_gen.connect("clicked", lambda _b: tok_entry.set_text(secrets.token_hex(32)))
        for w in (tok_entry, tok_show, tok_gen):
            tok.append(w)
        add("Токен", tok, "общий секрет, одинаковый на обеих машинах")
        readers["token"] = lambda: tok_entry.get_text().strip()
        dropdown("backend", "Композитор", BACKENDS, "как узнать активное окно")
        spin("port", "Порт демона", 1, 65535, 1)
        entry("listen", "Слушать адрес", "0.0.0.0 — все интерфейсы")
        switch("notify", "Уведомления об ошибках")

        section("Сосед")
        entry("peer.name", "Имя соседа", "должно совпадать с его name")
        entry("peer.host", "Адрес (IP)", "IP или имя соседа в сети")
        spin("peer.port", "Порт демона соседа", 1, 65535, 1)
        entry("peer.ssh", "SSH", "user@192.168.1.20 или алиас из ~/.ssh/config")

        section("Буфер обмена")
        switch("clipboard", "Синхронизировать")
        spin("clipboard_interval", "Интервал опроса, с", 0.1, 10, 0.1, digits=1)
        spin("clipboard_max_kb", "Максимум, КБ", 1, 102400, 64)

        section("xpra")
        dropdown("xpra.encoding", "Кодирование", ENCODINGS)
        spin("xpra.quality", "Качество (0 = авто)", 0, 100, 5)
        switch("xpra.speaker", "Пересылать звук", "нужен gst-python")
        switch("xpra.microphone", "Пересылать микрофон")
        spin("xpra.display_base", "Первый дисплей", 10, 9000, 1)
        list_entry("xpra.server_args", "Аргументы сервера")
        list_entry("xpra.attach_args", "Аргументы клиента")

        section("Установка на соседа")
        entry("setup.repo", "Репозиторий")
        entry("setup.dir", "Папка у соседа")
        list_entry("setup.packages", "Пакеты")

        status = Gtk.Label(xalign=0, wrap=True, selectable=True)
        outer.append(status)
        out_view = Gtk.TextView(editable=False, monospace=True)
        out_scroll = Gtk.ScrolledWindow(min_content_height=120, visible=False)
        out_scroll.set_child(out_view)
        outer.append(out_scroll)

        def say(text, error=False):
            color = "#e06c75" if error else "#98c379"
            status.set_markup(f"<span foreground='{color}'>{GLib.markup_escape_text(text)}</span>")

        def collect():
            new = copy.deepcopy(cfg)
            for k, read in readers.items():
                put(new, k, read())
            return new

        def save(_b=None):
            try:
                new = collect()
                if not new["name"] or " " in new["name"]:
                    raise WindriftError("имя машины пустое или с пробелами")
                if not new["token"]:
                    new["token"] = secrets.token_hex(32)
                    tok_entry.set_text(new["token"])
                save_config(new, path)
                cfg.clear()
                cfg.update(new)
                say(f"Сохранено: {path}")
                return True
            except (WindriftError, ValueError, OSError) as e:
                say(f"Ошибка: {e}", error=True)
                return False

        def doctor(_b):
            if not save():
                return
            say("Проверяю…")

            def work():
                r = subprocess.run([sys.executable, script, "--config", str(path), "doctor"],
                                   capture_output=True, text=True)
                GLib.idle_add(lambda: (out_scroll.set_visible(True),
                                       out_view.get_buffer().set_text(r.stdout + r.stderr),
                                       say("Всё в порядке" if r.returncode == 0 else "Есть проблемы — см. ниже",
                                           error=r.returncode != 0)) and False)
            threading.Thread(target=work, daemon=True).start()

        def setup_peer(_b):
            if not save():
                return
            if not cfg["peer"]["ssh"] or not cfg["peer"]["name"]:
                say("Заполни имя соседа и SSH", error=True)
                return
            cmd = [sys.executable, script, "--config", str(path), "setup-peer"]
            if open_in_terminal(cmd):
                say("Установка идёт в окне терминала")
            else:
                say("Терминал не найден. Запусти вручную: windrift setup-peer", error=True)

        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        for label, cb in (("Проверить связь", doctor), ("Установить на соседа", setup_peer),
                          ("Сохранить", save)):
            b = Gtk.Button(label=label)
            b.connect("clicked", cb)
            buttons.append(b)
        buttons.get_last_child().add_css_class("suggested-action")
        outer.append(buttons)
        win.present()

    app = Gtk.Application(application_id="io.github.windrift.Settings")
    app.connect("activate", on_activate)
    app.run([])


# ───────────────────────── main ─────────────────────────

def main() -> None:
    ap = argparse.ArgumentParser(prog="windrift", description="перенос живых окон между двумя машинами")
    ap.add_argument("--config", type=Path, default=CONFIG_PATH)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p_init = sub.add_parser("init", help="создать конфиг со всеми настройками")
    p_init.add_argument("--force", action="store_true")
    sub.add_parser("settings", help="окно настроек")
    p_setup = sub.add_parser("setup-peer", help="установить и настроить windrift на соседе по SSH")
    p_setup.add_argument("ssh", nargs="?", help="user@host или ssh-алиас (по умолчанию peer.ssh)")
    p_setup.add_argument("--backend", choices=BACKENDS, help="композитор соседа (по умолчанию как здесь)")
    p_run = sub.add_parser("run", help="запустить программу в переносимой сессии")
    p_run.add_argument("argv", nargs=argparse.REMAINDER)
    sub.add_parser("send", help="отправить активное окно соседу")
    sub.add_parser("daemon", help="запустить демон")
    sub.add_parser("list", help="локальные сессии")
    p_stop = sub.add_parser("stop", help="остановить сессию")
    p_stop.add_argument("display", type=int)
    sub.add_parser("doctor", help="проверить окружение")
    a = ap.parse_args()

    try:
        match a.cmd:
            case "init": cmd_init(a.config, a.force)
            case "settings": cmd_settings(a.config)
            case "setup-peer": cmd_setup_peer(load_config(a.config, strict=False), a.ssh, a.backend)
            case "run": cmd_run(load_config(a.config), a.argv)
            case "send": cmd_send(load_config(a.config))
            case "daemon": asyncio.run(daemon(load_config(a.config)))
            case "list": cmd_list(load_config(a.config))
            case "stop": cmd_stop(load_config(a.config), a.display)
            case "doctor": cmd_doctor(load_config(a.config))
    except (WindriftError, OSError, subprocess.CalledProcessError) as e:
        notify(f"ошибка: {e}")
        sys.exit(1)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
