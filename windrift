    sport = 20000 + secrets.randbelow(30000)
    via_me = f"-o Acquire::https::Proxy::xpra.org=socks5h://127.0.0.1:{sport}"
    remote_bash(target, f"""set -e
if command -v pacman >/dev/null; then
